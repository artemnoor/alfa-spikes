{
  "name": "t10-business-understanding",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node --test test/contracts.test.mjs test/identity.test.mjs test/documents.test.mjs test/entities.test.mjs test/entity-resolution.test.mjs test/relationship-resolution.test.mjs test/relationships.test.mjs test/semantic-evidence.test.mjs test/retrieval.test.mjs test/negative-benchmark.test.mjs test/independent-holdout.test.mjs test/gaps-profile.test.mjs test/public-fetch.test.mjs test/benchmark.test.mjs",
    "test:api": "node --env-file-if-exists=.env --test test/api.integration.test.mjs",
    "benchmark": "node benchmark/run.mjs",
    "benchmark:live": "node --env-file-if-exists=.env benchmark/run-live.mjs",
    "benchmark:evaluate-live": "node benchmark/evaluate-live-relations.mjs",
    "benchmark:real": "node --env-file-if-exists=.env benchmark/run-real-live.mjs",
    "benchmark:retrieval-live": "node --env-file-if-exists=.env benchmark/run-retrieval-live.mjs",
    "benchmark:negative-live": "node --env-file-if-exists=.env benchmark/run-negative-live.mjs",
    "benchmark:holdout-live": "node --env-file-if-exists=.env benchmark/run-independent-holdout-live.mjs",
    "benchmark:holdout-retrieval-live": "node --env-file-if-exists=.env benchmark/run-independent-retrieval-live.mjs",
    "benchmark:evaluate-real": "node benchmark/evaluate-real-run.mjs",
    "benchmark:gaps": "node benchmark/run-gaps.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1"
  }
}
